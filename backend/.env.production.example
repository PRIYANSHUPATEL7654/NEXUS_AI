# Choose one database configuration style. Hosted PostgreSQL normally supplies DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a unique value with at least 32 characters. Never commit the real value.
JWT_SECRET_KEY=replace-with-a-unique-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Exact deployed frontend origin, without a trailing slash.
CORS_ORIGINS=https://your-frontend.example

RUN_MIGRATIONS=true
LOG_LEVEL=info
SQL_ECHO=false
UPLOAD_DIRECTORY=/tmp/nexus-uploads
MAX_UPLOAD_SIZE_MB=10
